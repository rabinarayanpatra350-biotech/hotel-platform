# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing here is a real secret; production values
# are set in the Render/Vercel dashboards and never committed.
# ---------------------------------------------------------------------------

# Node environment: development | test | production
NODE_ENV=development
PORT=4000

# PostgreSQL. Locally: `npm run db:local` prints a URL for a throwaway instance.
# In production this is the managed Render Postgres connection string.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/hotel
# Render requires TLS; set to true there and leave unset locally.
DATABASE_SSL=false

# JWT secrets. MUST be at least 32 characters in production — the app refuses
# to boot otherwise, because a weak signing key is a silent total compromise.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Comma-separated list of allowed browser origins. Never "*" in production.
CORS_ORIGINS=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_PUBLIC_BASE_URL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# Fallback FX rate used only when a source row carries no explicit rate
FX_USD_INR=84.5

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Email and background jobs (the stretch requirement)
# ---------------------------------------------------------------------------
# console (dev, prints to the log) | record (tests, sends nothing) | smtp (production)
MAIL_TRANSPORT=console
MAIL_FROM=Mumbai Boutique Hotels <bookings@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
STAFF_NOTIFICATION_EMAIL=front-desk@example.com

JOB_POLL_INTERVAL_MS=1000
JOB_VISIBILITY_TIMEOUT_MS=300000
JOBS_ENABLED=true
